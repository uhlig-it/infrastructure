---
# Copy to secrets.yml and encrypt with ansible-vault.
# Variable names collected from the per-repo vaults; fill in the values.
#
# --- MQTT ---
# mosquitto_users: {}
# mqtt:
#   endpoint:
#   username:
#   password:
# mqtt_url: mqtt://user:pass@host:1883
#
# --- github-heartbeat ---
# Read-only fine-grained PAT: Metadata, Pull requests, Issues and Dependabot
# alerts, limited to the suhlig and uhlig-it owners. The matching broker user
# (`github-heartbeat`) goes in mosquitto_users in inventory/host_vars/opus/secrets.yml.
# vault_github_heartbeat_token:
#
# --- metrics ---
# node_exporter_password:
# prometheus_password_suhlig:
# gotosocial_metrics_password:
# watchtower_bearer_token:
# gosund_metrics_password:
#
# --- kehrkraft ---
# kehrkraft:
#   fqdn: kehrkraft.uhlig.it
#   port: 8083
#   admin_user:
#   admin_pass:
#   backup_bucket:
#   backup_access_key:
#   backup_secret_key:
#   backup_passphrase:
#   backup_endpoint:
#   backup_region:
#   backup_prefix:
#   backup_max_age_hours:
#
# --- uhlig.social (GoToSocial) ---
# uhlig_social:
#   hostname:
#   port:
#   runtime_user:
#   admin_user:
#     username:
#     email:
#     password:
#   backup:
#     keyId:
#     applicationKey:
#
# --- Concourse ---
# concourse_postgres_user:
# concourse_postgres_password:
# concourse_postgres_database:
#
# --- mosquitto-exporter ---
# bind_address:
#
# --- shorts ---
# shorts_fqdn:
# shorts_port:
#
