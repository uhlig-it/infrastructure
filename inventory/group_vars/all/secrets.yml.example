---
# Copy to secrets.yml and encrypt with ansible-vault.
# Variable names collected from the per-repo vaults; fill in the values.
#
# --- MQTT ---
# mosquitto_users: {}
# mqtt:
#   endpoint:
#   username:
#   password:
# mqtt_url: mqtt://user:pass@host:1883
#
# --- github-heartbeat ---
# Read-only fine-grained PATs, one per resource owner:
#   vault_github_heartbeat_token            for suhlig
#   vault_github_heartbeat_token_uhlig_it   for uhlig-it (falls back to the above)
# Each needs Metadata, Pull requests, Issues and Dependabot alerts, all read-only.
# A classic PAT with repo + security_events can replace both, at the cost of
# much broader access. The matching broker user (`github-heartbeat`) goes in
# mosquitto_users in inventory/host_vars/opus/secrets.yml.
# vault_github_heartbeat_token:
# vault_github_heartbeat_token_uhlig_it:
#
# --- metrics ---
# node_exporter_password:
# prometheus_password_suhlig:
# gotosocial_metrics_password:
# watchtower_bearer_token:
# gosund_metrics_password:
#
# --- kehrkraft ---
# kehrkraft:
#   fqdn: kehrkraft.uhlig.it
#   port: 8083
#   admin_user:
#   admin_pass:
#   backup_bucket:
#   backup_access_key:
#   backup_secret_key:
#   backup_passphrase:
#   backup_endpoint:
#   backup_region:
#   backup_prefix:
#   backup_max_age_hours:
#
# --- uhlig.social (GoToSocial) ---
# uhlig_social:
#   hostname:
#   port:
#   runtime_user:
#   admin_user:
#     username:
#     email:
#     password:
#   backup:
#     keyId:
#     applicationKey:
#
