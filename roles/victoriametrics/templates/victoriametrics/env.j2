# Read by the systemd unit via EnvironmentFile= and expanded into
# VictoriaMetrics flags via -envflag.enable -envflag.prefix=VM_.
{% if victoriametrics_http_auth_password | length > 0 %}
VM_httpAuth_username={{ victoriametrics_http_auth_username }}
VM_httpAuth_password={{ victoriametrics_http_auth_password | quote }}
{% endif %}
