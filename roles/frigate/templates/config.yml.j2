# {{ ansible_managed }}
mqtt:
  enabled: true
  host: {{ frigate.mqtt.host }}
  user: {{ frigate.mqtt.user }}
  password: {{ frigate.mqtt.password }}
# Only one profile can be active at a time; switching happens via
# `frigate/profile/set` (e.g. from the alarm state machine on opus or HA).
profiles:
  disarmed:
    friendly_name: Disarmed
  armed:
    friendly_name: Armed
# Audio events (smoke/fire) run on the INMP441 node streams. `listen` and
# min_volume are global; a camera opts in with an `audio` input and a
# camera-level `audio.enabled`. The global default stays off, so cameras
# without a microphone are untouched. See docs/smoke-detection-plan.md.
audio:
  listen:
    - smoke_detector
    - fire_alarm
  min_volume: {{ frigate_audio_min_volume }}
cameras:
{% for name, camera in frigate.cameras.items() %}
{% set audio_only = camera.audio_only | default(false) %}
{% set has_audio = camera.mic is defined %}
  {{ name }}:
    enabled: true
    ffmpeg:
{% if audio_only %}
      hwaccel_args: ""   # the placeholder is MJPEG; the GPU decode preset doesn't apply
{% endif %}
      inputs:
{% if camera.source is defined %}
        - path: rtsp://127.0.0.1:8554/{{ name }}
          input_args: preset-rtsp-restream
          roles:
            - detect
{% if not audio_only %}
            - record
{% endif %}
{% elif camera.video is defined %}
        # A placeholder decode source: the audio-only node serves a fixed frame
        # (Frigate decodes a stream per camera, even with detect disabled).
        # Not RTSP, so the default rtsp input args don't apply.
        - path: {{ camera.video }}
          input_args: "-avoid_negative_ts make_zero -fflags +genpts+discardcorrupt -use_wallclock_as_timestamps 1"
          roles:
            - detect
{% endif %}
{% if has_audio %}
        # The microphone node serves a single RTSP client; being audio-only,
        # go2rtc cannot restream it, so Frigate reads the node directly.
        - path: {{ camera.mic }}
          roles:
            - audio
    audio:
      enabled: true
{% endif %}
{% if audio_only %}
    detect:
      enabled: false
    record:
      enabled: false
    snapshots:
      enabled: false
{% else %}
    live:
      streams:
        Stream 1: {{ name }}
    objects:
      track: [person]
    review:
      alerts:
        labels: [person]
    mqtt:
      enabled: false # do not publish snapshot via mqtt
{% endif %}
    profiles:
      armed:
{% if not audio_only %}
        detect:
          enabled: true
        record:
          enabled: true
{% endif %}
{% if has_audio %}
        audio:
          enabled: true
{% endif %}
      disarmed:
{% if not audio_only %}
        detect:
          enabled: false
        motion:
          enabled: false
        record:
          enabled: false
{% endif %}
{% if has_audio %}
        audio:
          enabled: {{ 'false' if camera.disarm_audio | default(false) else 'true' }}
{% endif %}
{% endfor %}
# go2rtc holds the real video sources; each camera above reads Frigate's own
# restream so a stream is opened once and shared (detect + record + live).
# (Audio-only microphones are read directly by Frigate -- see above.)
go2rtc:
  streams:
{% for name, camera in frigate.cameras.items() if camera.source is defined %}
    {{ name }}:
      - {{ camera.source }}
{% endfor %}
detectors:
  coral:
    type: edgetpu
    device: usb
objects:
  track:
    - person
    - car
    - bird
    - cat
    - dog
# Schema for Frigate 0.15+ (older `retain`/`events` keys are migrated on startup).
# If recordings are ever deleted manually, set `sync_recordings: true` here
# temporarily so Frigate drops the stale database entries.
record:
  enabled: true
  motion:
    days: {{ frigate_record_retain_days }}
  alerts:
    retain:
      days: {{ frigate_record_retain_days }}
      mode: active_objects
  detections:
    retain:
      days: {{ frigate_record_retain_days }}
      mode: active_objects
ffmpeg:
  hwaccel_args: preset-intel-qsv-h264
# Event snapshots are attached to alarm notifications: shop-alarm fetches
# /api/review/<id>/snapshot.jpg for the triggering review. Frigate leaves
# snapshots off unless the key is present, which yielded a black attachment
# (incident 2026-09-24).
snapshots:
  enabled: true
  timestamp: false
  bounding_box: true
  retain:
    default: 3
birdseye:
  enabled: false
