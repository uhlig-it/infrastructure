# Rendered by roles/paseo into /opt/paseo/home/.gitconfig, which the container
# mounts as ~/.gitconfig. Two different things live here:
#
#   [user]       who the commit is authored as. Independent of the credential:
#                GitHub links a commit to the account that owns the email.
#   [credential] how git authenticates to GitHub. The helper reads the token
#                from gh's hosts.yml, so no secret is stored in this file.
#
# The helper path is absolute on purpose: agent shells are not always login
# shells, and a bare `gh` would fail with "credential helper not found".
[user]
	name = {{ paseo_git_user_name }}
	email = {{ paseo_git_user_email }}
[credential "https://github.com"]
	helper =
	helper = !/usr/local/bin/gh auth git-credential
