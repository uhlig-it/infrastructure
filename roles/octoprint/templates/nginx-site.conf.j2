# {{ ansible_managed }}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ octoprint_proxy_listen }};
    server_name {{ octoprint_service_fqdn }};

    # OctoPrint
    location / {
        proxy_pass http://127.0.0.1:{{ octoprint_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Scheme https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # mjpg-streamer (OctoPrint's classic webcam). It serves at "/", so strip
    # the /webcam prefix.
    location /webcam/ {
        proxy_pass http://127.0.0.1:{{ octoprint_webcam_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
